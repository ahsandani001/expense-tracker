<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Spendly' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <span class="brand-icon">◈</span>
                <span class="brand-name">Spendly</span>
            </a>
            <div class="nav-links">
                <% if (isLoggedIn) { %>
                    <a href="/logout" class="nav-logout">Logout</a>
                <% } else { %>
                    <a href="/login">Sign in</a>
                    <a href="/register" class="nav-cta">Get started</a>
                <% } %>
            </div>
        </div>
    </nav>

    <% if (typeof loginSuccess !== 'undefined' && loginSuccess) { %>
    <section class="auth-success-section">
        <div class="auth-success-inner">
            <div class="auth-success-message">
                <div class="auth-success-icon">✓</div>
                <h3 class="auth-success-title">Successfully logged in!</h3>
                <p class="auth-success-body">Welcome back. You are now logged into your Spendly account.</p>
            </div>
        </div>
    </section>
    <% } %>

    <main class="main-content">
        <%- body %>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span class="brand-icon">◈</span>
            <span class="footer-name">Spendly</span>
            <p class="footer-copy">Track every rupee. Own your finances.</p>
            <a href="/terms">Terms and Conditions</a>
            <a href="/privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>

</html>
