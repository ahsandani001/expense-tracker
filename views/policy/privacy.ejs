<% const body=` <section class="policy-hero">
    <div class="policy-hero-inner">
        <div class="hero-badge">Privacy</div>
        <h1 class="policy-title">Privacy Policy</h1>
        <p class="policy-subtitle">
            This Privacy Policy explains how Spendly collects, uses, stores, and
            protects your personal financial information when you use our expense
            tracking service.
        </p>
        <p class="policy-updated">
            Last updated: January 1, 2026
        </p>
    </div>
    </section>

    <section class="policy-content">
        <div class="policy-inner">
            <div class="policy-card">
                <div class="policy-stack">

                    <div class="policy-section">
                        <h2 class="policy-section-title">1. Data We Collect</h2>
                        <p class="policy-body">
                            We collect personal information you provide directly when
                            you use Spendly, including your name, email address, and
                            password when you create an account. We also collect the
                            expense entries you add — such as category, amount, date,
                            and description — along with any notes or attachments you
                            attach to them. We may automatically collect usage data
                            such as browser type, IP address, device information, and
                            interaction patterns to improve the service.
                        </p>
                    </div>

                    <div class="policy-section">
                        <h2 class="policy-section-title">2. How We Use Your Data</h2>
                        <p class="policy-body">
                            Your data is used to provide and operate the Spendly
                            service: to log and categorize your expenses, generate
                            spending summaries and reports, and authenticate your
                            account. We use your email to send account-related
                            communications such as password resets and service
                            notifications. We do not use your personal financial data
                            for advertising or sell it to third parties.
                        </p>
                    </div>

                    <div class="policy-section">
                        <h2 class="policy-section-title">3. Data Storage</h2>
                        <p class="policy-body">
                            Your account information and expense data are stored on
                            secure servers, which may be located within your country
                            or abroad. We protect your data with encryption in transit
                            and at rest, and restrict access to authorized personnel
                            only. However, no method of transmission over the Internet
                            is completely secure, and we cannot guarantee absolute
                            security. You may request deletion of your account and all
                            associated data at any time.
                        </p>
                    </div>

                    <div class="policy-section">
                        <h2 class="policy-section-title">4. Third Party Services</h2>
                        <p class="policy-body">
                            Spendly may use trusted third-party providers for
                            infrastructure, analytics, error tracking, and payment
                            processing. These providers only receive the data
                            necessary to perform their services and are contractually
                            obligated to keep your data confidential and secure. We do
                            not share your data with advertisers, data brokers, or any
                            other third parties for marketing purposes.
                        </p>
                    </div>

                    <div class="policy-section">
                        <h2 class="policy-section-title">5. Your Rights</h2>
                        <p class="policy-body">
                            You have the right to access, correct, or delete the
                            personal information we hold about you. You may request a
                            copy of your data, ask us to correct inaccurate
                            information, or withdraw your consent by contacting us. We
                            will respond to requests within a reasonable timeframe,
                            subject to any legal obligations to retain certain records.
                        </p>
                    </div>

                    <div class="policy-section">
                        <h2 class="policy-section-title">6. Contact Us</h2>
                        <p class="policy-body">
                            If you have any questions, concerns, or requests about
                            this Privacy Policy or your data, please contact us at
                            privacy@spendly.example. We will make every reasonable
                            effort to respond to your inquiry promptly and helpfully.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    `;
    -%>
    <%- include('../layouts/base', { title: 'Privacy Policy — Spendly' , body }) %>
